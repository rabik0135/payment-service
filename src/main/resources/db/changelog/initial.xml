<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:mongodb="http://www.liquibase.org/xml/ns/mongodb"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
        http://www.liquibase.org/xml/ns/mongodb
        http://www.liquibase.org/xml/ns/mongodb/liquibase-mongodb-latest.xsd">

    <changeSet id="1" author="rabinchuk">
        <mongodb:createCollection collectionName="payments"/>

        <mongodb:createIndex collectionName="payments">
            <mongodb:keys>{ "order_id": 1 }</mongodb:keys>
            <mongodb:options>{ "name": "idx_payments_order_id" }</mongodb:options>
        </mongodb:createIndex>

        <mongodb:createIndex collectionName="payments">
            <mongodb:keys>{ "user_id": 1 }</mongodb:keys>
            <mongodb:options>{ "name": "idx_payments_user_id" }</mongodb:options>
        </mongodb:createIndex>

        <mongodb:createIndex collectionName="payments">
            <mongodb:keys>{ "status": 1 }</mongodb:keys>
            <mongodb:options>{ "name": "idx_payments_status" }</mongodb:options>
        </mongodb:createIndex>

        <mongodb:createIndex collectionName="payments">
            <mongodb:keys>{ "timestamp": 1 }</mongodb:keys>
            <mongodb:options>{ "name": "idx_payments_timestamp" }</mongodb:options>
        </mongodb:createIndex>
    </changeSet>

    <changeSet id="2" author="rabinchuk">
        <mongodb:createCollection collectionName="outbox_payments"/>

        <mongodb:createIndex collectionName="outbox_payments">
            <mongodb:keys>{ "payment_id": 1 }</mongodb:keys>
            <mongodb:options>{ "name": "idx_outbox_payments_payment_id" }</mongodb:options>
        </mongodb:createIndex>
    </changeSet>

</databaseChangeLog>